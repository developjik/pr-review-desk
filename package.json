{
  "name": "pr-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "daemon",
    "shared"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:sidecar": "cd daemon && npm run build:sidecar",
    "prebuild": "npm run build:sidecar",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p daemon/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node daemon-e2e-harness.mjs"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
