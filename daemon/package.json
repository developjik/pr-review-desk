{
  "name": "@pr-review/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PR Review sidecar daemon (stdio JSON-line IPC over stdin/stdout)",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main.cjs --resolve-extensions=.ts,.js --inject:./build/import-meta-url-shim.js --define:import.meta.url=url --log-level=warning",
    "build:sidecar": "npm run build:bundle && node build-sidecar.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "@pr-review/shared": "*",
    "node-cron": "^4.6.0",
    "p-limit": "^6.2.0",
    "openai": "^4.77.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/node-cron": "^3.0.11",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3"
  }
}
